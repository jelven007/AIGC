{
  "name": "shoproai",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.dev.ts --host 0.0.0.0",
    "build": "vite build",
    "test:finance": "python3 tests/test_finance.py",
    "test:cash": "python3 tests/test_cash_refunds.py && node tests/cash_refunds.test.mjs",
    "test:payments": "node tests/run_wechat.mjs && node tests/ai_billing.test.mjs && node tests/payment_notify.test.mjs",
    "test:video": "node tests/video_jobs.test.mjs",
    "test:batch": "python3 tests/test_batch_video.py && node tests/batch_video.test.mjs",
    "test:models": "node tests/model_settings.test.mjs && node tests/audio_models.test.mjs",
    "test:media": "python3 tests/test_media_jobs.py && node tests/media_jobs.test.mjs",
    "test:analysis": "python3 tests/test_video_analysis.py && node tests/video_analysis.test.mjs && docker run --rm -v \"$PWD:/app\" -w /app shoproai-render-worker:local python tests/test_analysis_media.py",
    "test:measurements": "python3 tests/test_measurements.py && node tests/measurements.test.mjs",
    "test:knowledge": "python3 tests/test_knowledge.py && node tests/knowledge.test.mjs",
    "test:intelligence": "python3 tests/test_intelligence.py && node tests/intelligence.test.mjs",
    "test:scheduler": "python3 tests/test_video_scheduler.py && python3 tests/test_video_schedule_db.py",
    "test:volcengine": "python3 tests/test_volcengine_deploy.py && node tests/volcengine.test.mjs",
    "test:production": "node tests/production_jobs.test.mjs",
    "test:publish": "python3 tests/test_publish_groups.py && node tests/publish_groups.test.mjs",
    "test:products": "python3 tests/test_products.py && node tests/products.test.mjs",
    "test:translation": "python3 tests/test_translation_notifications.py && node tests/product_translation.test.mjs",
    "test:task-center": "node tests/task_center.test.mjs",
    "test:access": "python3 tests/test_access_control.py && node tests/access_control.test.mjs",
    "test:mcp": "node tests/mcp_scopes.test.mjs && docker run --rm -v \"$PWD:/workspace\" -w /workspace shoproai-mcp:local python tests/test_mcp_backend.py && docker run --rm -v \"$PWD:/workspace\" -w /workspace shoproai-mcp:local python mcp/export_tools.py --check",
    "test:render": "node tests/render_effects.test.mjs && docker run --rm -v \"$PWD:/app\" -w /app shoproai-render-worker:local python tests/test_render.py",
    "test:exports": "python3 tests/test_render_exports.py && node tests/render_exports.test.mjs",
    "deploy:prepare": "python3 scripts/deploy_volcengine.py prepare",
    "scheduler:start": "python3 scripts/manage_video_scheduler.py start",
    "scheduler:status": "python3 scripts/manage_video_scheduler.py status",
    "scheduler:stop": "python3 scripts/manage_video_scheduler.py stop",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "npm run typecheck && biome lint && bash .rules/check.sh && tailwindcss -i ./src/index.css -o /dev/null && bash .rules/testBuild.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
