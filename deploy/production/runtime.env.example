# 复制为runtime.env，chmod600；此文件只含公开配置/路径，不写管理令牌或service_role。
# 最终HTTPS入口由目标反向代理提供；容器只绑定本机8081/8082。
RELEASE_DIR=/srv/shopro/releases/本次源码SHA256
SUPABASE_URL=https://bbqqhkukgbgpebqpesub.supabase.co
SUPABASE_ANON_KEY=
SCHEDULER_IMAGE=
RENDERER_IMAGE=
MCP_IMAGE=
RUNTIME_SECRETS_DIR=/srv/shopro/secrets
RENDER_WORKSPACE_PATH=/srv/shopro/media
RENDER_MEDIA_HOSTS=
WEB_PORT=8081
MCP_PORT=8082
# 填写实际反向代理保留的Host；需要端口时单列。不得填写URL或通配符。
MCP_ALLOWED_HOSTS=
