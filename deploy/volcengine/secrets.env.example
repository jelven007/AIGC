# 复制为 secrets.env 并设置 chmod 600；通过 byted-supabase-cli secrets set --env-file 注入。
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 由平台提供，不在这里覆盖。
# 32 字节随机主密钥的 64 位十六进制表示，需备份；丢失后无法解密历史任务凭据。
MODEL_CONFIG_ENCRYPTION_KEY=
VIDEO_WORKER_SECRET=

# 各模型 API Key / endpoint / Model ID 在 /settings/models 页面配置。
# 历史 ARK / GLM / DEEPSEEK / SILICONFLOW 等 Secrets 只供显式导入，不供运行时回退。
# 旧异步图片网关不兼容 OpenAI Images，需在页面手工填写真实支持协议的接口。

# 支付按账号实际配置；公开回调使用完整 BaaS 函数地址。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SITE_URL=
ALIPAY_NOTIFY_URL=
MERCHANT_APP_ID=
MERCHANT_ID=
MCH_API_V3_KEY=
MCH_PRIVATE_KEY=
MCH_CERT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
