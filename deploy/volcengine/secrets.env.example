# 复制为 secrets.env 并设置 chmod 600；通过 byted-supabase-cli secrets set --env-file 注入。
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 由平台提供，不在这里覆盖。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 填写账号实际已开通的 Model ID 或 Endpoint ID，不使用演示占位模型。
ARK_TEXT_MODEL=
ARK_VIDEO_MODEL=
VIDEO_WORKER_SECRET=

# 音频使用现有 SiliconFlow 协议，由火山 Edge Function 代理。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 可选模型，未配置时在扣积分之前拒绝。
OPENAI_NEXT_API_KEY=
TOKENDANCE_API_KEY=
CDANCE_API_KEY=
KLING_API_KEY=
KLING_CREATE_URL=
KLING_QUERY_URL=

# 可选专属服务，缺少地址不会请求源仓库网关。
URL_READER_BASE_URL=
URL_READER_API_KEY=
IMAGE_GATEWAY_CREATE_URL=
IMAGE_GATEWAY_QUERY_URL=
INTEGRATIONS_API_KEY=

# 支付按账号实际配置；公开回调使用完整 BaaS 函数地址。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SITE_URL=
ALIPAY_NOTIFY_URL=
MERCHANT_APP_ID=
MERCHANT_ID=
MCH_API_V3_KEY=
MCH_PRIVATE_KEY=
MCH_CERT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
