{
  "include": ["./apps/web/src"],
  "exclude": ["./apps/web/src/**/*.test.ts", "./apps/web/src/**/*.spec.ts", "./apps/web/src/components/ui"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  }
}
