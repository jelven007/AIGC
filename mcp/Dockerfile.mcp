FROM python:3.12-slim

WORKDIR /app

COPY requirements_mcp.txt .
RUN pip install --no-cache-dir -r requirements_mcp.txt

COPY mcp_server.py .
COPY mcp_server_stdio.py .
COPY mcp_shopro_server.py .
COPY mcp_shopro_server_stdio.py .
COPY backend_client.py .
COPY http_server.py .
COPY export_tools.py .
COPY tools.json .

EXPOSE 8080

ENV HOST=0.0.0.0
ENV PORT=8080

USER 65534:65534
CMD ["python", "http_server.py"]
