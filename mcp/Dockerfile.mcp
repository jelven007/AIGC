ARG PYTHON_IMAGE=python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
FROM ${PYTHON_IMAGE}
ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock && pip check

COPY mcp_server.py .
COPY mcp_server_stdio.py .
COPY mcp_shopro_server.py .
COPY mcp_shopro_server_stdio.py .
COPY backend_client.py .
COPY backend_tls.py .
COPY http_server.py .
COPY host_config.py .
COPY export_tools.py .
COPY tools.json .

EXPOSE 8080

ENV HOST=0.0.0.0
ENV PORT=8080

USER 65534:65534
CMD ["python", "http_server.py"]
