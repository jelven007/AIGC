            "title": "Knowledge Job Id"
          }
        },
        "required": [
          "product_highlights",
          "target_audience"
        ],
        "title": "generate_marketing_scriptArguments",
        "type": "object"
      }
    },
    {
      "name": "translate_marketing_script",
      "description": "翻译脚本并保留分镜，使用管理员启用的文本模型。",
