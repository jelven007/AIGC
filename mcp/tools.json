    {
      "name": "submit_render_export",
      "description": "将已完成且不超过10分钟的作品导出1–18种比例/分辨率。返回导出组及子任务，使用query_render_export恢复。",
      "inputSchema": {
        "$defs": {
          "ExportFormat": {
            "additionalProperties": false,
            "properties": {
              "ratio": {
                "enum": [
                  "9:16",
                  "16:9",
                  "1:1",
                  "4:3",
                  "3:4",
                  "4:5"
                ],
                "title": "Ratio",
                "type": "string"
              },
              "height": {
                "enum": [
                  720,
                  1080,
                  2160
                ],
                "title": "Height",
                "type": "integer"
              }
            },
            "required": [
              "ratio",
              "height"
            ],
            "title": "ExportFormat",
            "type": "object"
          }
        },
        "properties": {
          "source_project_id": {
            "title": "Source Project Id",
            "type": "string"
          },
          "formats": {
            "items": {
              "$ref": "#/$defs/ExportFormat"
            },
            "title": "Formats",
            "type": "array"
          },
          "request_key": {
            "title": "Request Key",
            "type": "string"
          }
        },
        "required": [
          "source_project_id",
          "formats",
          "request_key"
        ],
        "title": "submit_render_exportArguments",
        "type": "object"
      }
    },
