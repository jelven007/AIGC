        ],
        "title": "translate_marketing_scriptArguments",
        "type": "object"
      }
    },
    {
      "name": "synthesize_voice_tts",
      "description": "创建后台配音任务。先get_media_prices确认tts价格，重试复用原UUID和参数；用query_production_status获取结果。",
      "inputSchema": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "request_key": {
            "title": "Request Key",
            "type": "string"
          },
          "confirmed_credit_cost": {
            "maximum": 100000,
            "minimum": 0,
            "title": "Confirmed Credit Cost",
            "type": "integer"
          },
          "voice_id": {
            "default": "",
            "title": "Voice Id",
            "type": "string"
          },
          "speed": {
            "default": 1.0,
            "title": "Speed",
            "type": "number"
          },
          "response_format": {
            "default": "mp3",
            "enum": [
              "mp3",
              "wav",
              "opus"
            ],
            "title": "Response Format",
            "type": "string"
          },
          "instruction": {
            "default": "",
            "title": "Instruction",
            "type": "string"
          },
          "voice_clone_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Voice Clone Id"
          }
        },
        "required": [
          "text",
          "request_key",
          "confirmed_credit_cost"
        ],
        "title": "synthesize_voice_ttsArguments",
        "type": "object"
      }
    },
    {
      "name": "enhance_prompt",
      "description": "扩展商品镜头提示词，模型由服务端配置。",
      "inputSchema": {
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "enhance_promptArguments",
        "type": "object"
      }
    },
    {
      "name": "submit_video_generation",
      "description": "创建服务端视频任务，七种协议按配置启用；参考图/视频使用已上传私有素材。同一请求重试必须复用UUID及参数。",
      "inputSchema": {
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "request_key": {
            "title": "Request Key",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "title": "Duration",
            "type": "integer"
          },
          "resolution": {
            "default": "720p",
            "title": "Resolution",
            "type": "string"
          },
          "ratio": {
            "default": "16:9",
            "title": "Ratio",
            "type": "string"
          },
          "first_frame_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "First Frame Url"
          },
          "watermark": {
            "default": false,
            "title": "Watermark",
            "type": "boolean"
          },
          "provider": {
            "default": "ArkSeedance",
            "enum": [
              "ArkSeedance",
              "MiniMax",
              "SeedanceMini",
              "Wan3",
              "HappyHorse",
              "Kling",
              "Seedance"
            ],
            "title": "Provider",
            "type": "string"
          },
          "last_frame_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Last Frame Url"
          },
          "reference_images": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reference Images"
          },
          "reference_videos": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reference Videos"
          }
        },
        "required": [
          "prompt",
          "request_key"
        ],
        "title": "submit_video_generationArguments",
        "type": "object"
      }
    },
    {
      "name": "query_video_status",
